{
  "name": "tixo-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "dev:network": "nuxt dev --host --qr",
    "build": "NODE_OPTIONS='--max-old-space-size=450' npx nuxi build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test:unit": "vitest run --logHeapUsage",
    "test:e2e": "playwright test",
    "lint": "eslint . --fix --cache",
    "type-check": "npx nuxi typecheck",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.1.0",
    "@pinia/nuxt": "^0.10.1",
    "@primeuix/themes": "^2.0.2",
    "@primevue/nuxt-module": "^4.3.1",
    "@tailwindcss/vite": "^4.1.18",
    "appwrite": "^21.5.0",
    "echarts": "^6.0.0",
    "nuxt": "^3.15.4",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "vue": "^3.5.26",
    "vue-echarts": "^8.0.1"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.0.0",
    "@nuxtjs/robots": "^5.7.1",
    "@nuxtjs/sitemap": "^7.6.0",
    "@playwright/test": "^1.57.0",
    "@tsconfig/node24": "^24.0.3",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitejs/plugin-vue-jsx": "^5.1.3",
    "@vitest/eslint-plugin": "^1.6.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.2",
    "eslint-plugin-playwright": "^2.4.0",
    "eslint-plugin-vue": "~10.6.2",
    "happy-dom": "^20.8.3",
    "jiti": "^2.6.1",
    "jsdom": "^27.4.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.7.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-qrcode": "^0.3.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^4.0.16",
    "vue-intellisense": "^1.0.3",
    "vue-tsc": "^3.2.2"
  }
}
